# Copie para .env e preencha:  cp .env.example .env
DOMINIO=honorarios.seudominio.com.br
ALLOWED_HOSTS=honorarios.seudominio.com.br
DEBUG=0
# Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_PASSWORD=troque-por-uma-senha-forte

# Asaas (boleto + PIX com baixa automática). Deixe vazio para não usar.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Invente um token e cadastre o MESMO no painel do Asaas (Integrações > Webhooks)
ASAAS_WEBHOOK_TOKEN=

# E-mail para avisos do portal e lembretes de honorários.
# Enquanto a linha EMAIL_BACKEND estiver com # na frente, os avisos são só registrados
# no sistema (Portal > Avisos por e-mail) e NÃO saem para a internet.
# Para ativar: tire o # do EMAIL_BACKEND e preencha os dados da conta de envio.
#   Google Workspace: smtp.gmail.com, 587 (use uma "senha de app")
#   Microsoft 365:    smtp.office365.com, 587
#   Brevo:            smtp-relay.brevo.com, 587
#   Amazon SES (SP):  email-smtp.sa-east-1.amazonaws.com, 587
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# EMAIL_USE_SSL=1   (só se o provedor pedir porta 465; nesse caso EMAIL_PORT=465)
# Remetente. Ex.: Contabilidade Silva <avisos@seuescritorio.com.br>
DEFAULT_FROM_EMAIL=
# Endereço usado nos links dos e-mails (vazio = https://DOMINIO)
SITE_URL=
